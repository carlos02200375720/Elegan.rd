rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
             data.description is string &&
             data.category is string &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string &&
             data.inStock is bool;
    }

    function isValidCartItem(data, userId) {
      return data.userId == userId &&
             data.productId is string && data.productId.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.quantity is int && data.quantity > 0;
    }

    function isValidSavedPublication(data, userId, productId) {
      return data.userId == userId &&
             data.productId == productId &&
             data.productId is string && data.productId.size() > 0;
    }

    function isValidOrder(data, userId) {
      return data.userId == userId &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.address is string && data.address.size() > 0 &&
             data.paymentMethod is string &&
             data.total is number && data.total >= 0 &&
             data.status is string;
    }

    function isValidSupportMessage(data, userId) {
      return data.userId == userId &&
             data.sender is string &&
             data.text is string && data.text.size() > 0;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.email is string && data.email.size() > 0;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() > 0 &&
             data.message is string &&
             data.type is string &&
             data.isActive is bool;
    }

    // Products: Available to authenticated users to read and seed, update, delete
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidProduct(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Announcements: Available to authenticated users
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidAnnouncement(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Users and subcollections
    match /users/{userId} {
      allow read, update, create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /cart/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCartItem(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /savedPublications/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          isValidSavedPublication(request.resource.data, userId, productId);
        allow delete: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOrder(request.resource.data, userId);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSupportMessage(request.resource.data, userId);
        allow update, delete: if false;
      }
    }
  }
}
