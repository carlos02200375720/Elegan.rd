{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Luxury fashion item in the Elegan store catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "sizes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inStock": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "category", "price", "imageUrl", "inStock"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Item stored in user shopping cart",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "selectedSize": { "type": "string" },
        "quantity": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "name", "price", "quantity"]
    },
    "Order": {
      "title": "Order",
      "description": "Completed purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "total": { "type": "number" },
        "itemCount": { "type": "integer" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "email", "address", "paymentMethod", "total", "status"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Support chat message between customer and Elegan Concierge",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sender": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sender", "text"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with contact and delivery information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products for Elegan store"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Items in user cart"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer completed orders"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Support chat messages for customer assistance"
    }
  }
}
